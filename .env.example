# GEMINI_API_KEY: Diperlukan untuk panggilan API Gemini AI.
# Diinjeksi otomatis di AI Studio jika diset di secret, atau dapat diatur pada .env lokal.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini yang digunakan (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: URL tempat applet di-hosting
APP_URL="MY_APP_URL"
